{
 "permissions": {
  "allow": [
   "mcp__kaptyorka"
  ],
  "deny": [
   "SendMessage",
   "ListAgents",
   "RemoteTrigger",
   "Artifact",
   "SendUserFile",
   "mcp__claude-in-chrome",
   "mcp__computer-use"
  ],
  "disableBypassPermissionsMode": "disable"
 },
 "disableClaudeAiConnectors": true,
 "env": {
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
 },
 "enableArtifact": false,
 "remoteControlAtStartup": false,
 "crossSessionInbound": "accept",
 "isolatePeerMachines": true,
 "sandbox": {
  "enabled": false
 },
 "autoUpdates": false,
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/usr/bin/python3 -I /opt/kaptyorka/box/current/helper.py hook claude SessionStart",
      "timeout": 10
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/usr/bin/python3 -I /opt/kaptyorka/box/current/helper.py hook claude UserPromptSubmit",
      "timeout": 10
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/usr/bin/python3 -I /opt/kaptyorka/box/current/helper.py hook claude Stop",
      "timeout": 10
     }
    ]
   }
  ],
  "SessionEnd": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/usr/bin/python3 -I /opt/kaptyorka/box/current/helper.py hook claude SessionEnd",
      "timeout": 5
     }
    ]
   }
  ]
 }
}
