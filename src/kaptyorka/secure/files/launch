#!/bin/sh
# kaptyorka launcher (secure design v2, 4.7). Root-owned; runs as the person. No network, reads
# no file. A folder is a team folder only by where it really is: /srv/team/<you>/<name>, where
# only root can put a folder. There the tool starts in the box; anywhere else your own tool.
# It is reached through the shell functions (launcher.sh, launcher.fish; bash exports them to its
# children) and through the shims first on PATH (/usr/local/libexec/kaptyorka/shims). What it
# cannot see: a tool started by its own path (~/.opencode/bin/opencode), an editor or extension
# that runs its own copy, a PATH with the person's own folder before the shims. For those, the
# person's view of a team folder covers its tool files (kaptyorka-guard).
tool=$1
case $tool in
  claude|opencode|codex|cursor-agent|git) shift ;;
  *) echo "launch: unknown tool" >&2; exit 2 ;;
esac
here=$(pwd -P 2>/dev/null) || here=
me=$(id -un)
team="/srv/team/$me/"
case "$here/" in
  "$team"?*) exec sudo -n /usr/local/libexec/kaptyorka/enter "$tool" "$@" ;;
esac
# Outside a team folder no argument may name one: `opencode ~/team/x`, `codex -C ~/team/x`,
# `cursor-agent --workspace=~/team/x` would load that folder's settings and plugins as you.
for a in "$@"; do
  case $a in -*=*) a=${a#*=} ;; esac
  [ -e "$a" ] || continue
  r=$(realpath -e -- "$a" 2>/dev/null) || continue
  case "$r/" in
    "$team"?*) echo "launch: $tool: that is a team folder; cd into it and run $tool there, so it starts in the team box" >&2
               exit 2 ;;
  esac
done
# personal: the next "$tool" on PATH after kaptyorka's shims (shell functions do not reach this script)
PATH=$(printf '%s' ":$PATH:" | sed 's#:/usr/local/libexec/kaptyorka/shims:#:#g; s#^:##; s#:$##')
exec "$tool" "$@"
